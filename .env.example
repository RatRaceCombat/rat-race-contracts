# Mainnet deployment setup. Copy to contracts/.env locally; never commit secrets.
# Used only on public mainnet networks. Local forks use .env.local; testnets use .env.testnet.
# Use real production roles, not the publicly known Hardhat test accounts.
DEPLOYER_PRIVATE_KEY=
OWNER_ADDRESS=
OWNER_KIND=trezor
SIGNER_ADDRESS=
DISTRIBUTOR_SIGNER_ADDRESS=
COSIGNER_ADDRESS=
GUARDIAN_ADDRESS=
TEAM_ADDRESS=
BUYBACK_ADDRESS=
MINTER_ADDRESS=
FEE_WALLET=
# The RAT token already exists on HyperEVM. These scripts deploy game contracts.
RAT_ADDRESS=0xfdc42f844f3aa19f8fc0b2d67d3276cf1efdc4ca
# Native Circle USDC, verified against Circle's official listing and mainnet bytecode calls.
USDC_ADDRESS=0xb88339CB7199b77E23DB6E890353E22632Ba630f
HYPEREVM_RPC=https://rpc.hyperliquid.xyz/evm
DELAY_SEC=1800
MAX_STEP_WITHDRAW_RAT=100000
MAX_STEP_SETTLE_RAT=50000
MAX_BOUNTY_RAT=50
SKINS_BASE_URI=https://play.ratracecombat.com/api/nft/
